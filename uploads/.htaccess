# Deny all direct web access to uploaded files.
#
# KYC documents, loan documents, and jewellery images are written here
# (application/controllers/api/v1/Kyc_document.php, Loan_document.php,
# Jewellery.php) and were meant to be readable only through their gated
# download endpoints (auth + require_role() + audit_log). Without this file,
# Apache serves anything under uploads/ as a static asset before CI3's
# front controller -- and therefore before any of those checks -- ever runs,
# because the root .htaccess only rewrites to index.php when the requested
# file does NOT already exist on disk (`RewriteCond %{REQUEST_FILENAME} !-f`).
# Every uploaded file trivially satisfies that condition, so the gate was
# being bypassed entirely by requesting the file's static path directly.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
