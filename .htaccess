<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /MaYo/GoldLon/MaYoGoldLoan/

    # Never serve internals, VCS data, dependencies, docs or dotfiles
    # (.env, .git, .htaccess ...). The front controller 404s for everything
    # else; [F] answers 403 outright. (".well-known" stays reachable for TLS.)
    RewriteRule ^(system|application|vendor|docs|\.git)(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Sensitive file types / project files must never be downloadable directly.
<FilesMatch "(^(composer\.(json|lock)|error_log|license\.txt|CLAUDE\.md|\.env.*)$|\.(env|sql|log|bak|old|orig|swp|md|zip|yml|yaml|ini|sh|dist)$)">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mime_module>
    AddHandler application/x-httpd-ea-php74 .php .php5 .phtml
</IfModule>

<IfModule mod_env.c>
    SetEnv CI_ENV production
</IfModule>
